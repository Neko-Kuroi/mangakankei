+def _active_suspension(db: Session, author_id: int, title_id: int):
+    """有効な公開停止があればその行を返す。"""
+    return (
+        db.query(Suspension)
+        .filter(Suspension.author_id == author_id,
+                Suspension.title_id == title_id,
+                Suspension.lifted_at.is_(None))
+        .first()
+    )
