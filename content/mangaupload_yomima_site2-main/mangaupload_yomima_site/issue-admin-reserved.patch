@@ -0,0 +1,308 @@
+"""管理者名の先取り対策の検証。
+
+- MANGA_ADMIN_USERS の名前（と、大文字小文字・全角・空白・ゼロ幅文字だけ違う名前）は
+  一般の登録に使えない。拒否の文言は「使用済み」と同じで、管理者名を明かさない
+- 管理者判定（is_admin）は完全一致のまま
+- manage.py（create-admin / list-admins）で管理者アカウントを作れる。
+  どのフォルダから実行しても、サイト側の DB を操作する
+- 起動時に、管理者名ごとのアカウント状況がログに出る（失敗しても起動は妨げない）
+"""
+import importlib.util
+import itertools
+import logging
+import os
+import subprocess
+import sys
+
+import pytest
+from fastapi.testclient import TestClient
+
+TAKEN = "使用済みのユーザー名です"
+_emails = itertools.count(1)
+
+
+@pytest.fixture(autouse=True)
+def _reset_limits(platform):
+    platform.limiter.reset()
+
+
+@pytest.fixture(scope="module")
+def manage(site_copy):
+    spec = importlib.util.spec_from_file_location("manage_mod", site_copy / "manage.py")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules["manage_mod"] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def signup(client, username, password="password123"):
+    return client.post("/api/auth/signup", json={
+        "username": username,
+        "email": f"reserved{next(_emails)}@example.com",
+        "password": password,
+    })
+
+
+def login(client, username, password="password123"):
+    return client.post("/api/auth/token", data={"username": username, "password": password})
+
+
+def bearer(client, username, password="password123"):
+    r = login(client, username, password)
+    assert r.status_code == 200, r.text
+    return {"Authorization": f"Bearer {r.json()['access_token']}"}
+
+
+# ---------------------------------------------------------------------------
+# 正規化
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize("name", [
+    "boss", "Boss", "BOSS", " boss ", "ｂｏｓｓ", "boss\u200b", "boss\u3000", "bo\u200bss",
+])
+def test_normalize_unifies_variants(platform, name):
+    assert platform.normalize_username(name) == "boss"
+
+
+@pytest.mark.parametrize("name", ["bossy", "b0ss", "bo ss", "bos"])
+def test_normalize_keeps_different_names_apart(platform, name):
+    assert platform.normalize_username(name) != "boss"
+
+
+# ---------------------------------------------------------------------------
+# 登録での予約
+# ---------------------------------------------------------------------------
+
+@pytest.mark.parametrize("name", [
+    "resv", "Resv", "RESV", " resv", "resv ", "ｒｅｓｖ", "resv\u200b", "resv\u3000",
+])
+def test_signup_rejects_reserved_names(platform_client, monkeypatch, name):
+    monkeypatch.setenv("MANGA_ADMIN_USERS", "resv")
+    r = signup(platform_client, name)
+    assert r.status_code == 400
+    assert r.json()["detail"] == TAKEN
+
+
+def test_reserved_message_is_same_as_duplicate(platform_client, monkeypatch):
+    monkeypatch.delenv("MANGA_ADMIN_USERS", raising=False)
+    assert signup(platform_client, "dupname").status_code == 200
+    duplicate = signup(platform_client, "dupname")
+    monkeypatch.setenv("MANGA_ADMIN_USERS", "resv2")
+    reserved = signup(platform_client, "resv2")
+    assert duplicate.status_code == reserved.status_code == 400
+    assert duplicate.json() == reserved.json()
+
+
+def test_other_names_are_not_affected(platform_client, monkeypatch):
+    monkeypatch.setenv("MANGA_ADMIN_USERS", "resv3")
+    assert signup(platform_client, "resv3x").status_code == 200
+    assert signup(platform_client, "xresv3").status_code == 200
+
