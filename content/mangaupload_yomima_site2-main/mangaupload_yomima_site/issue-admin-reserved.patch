+def test_startup_logs_admin_account_status(platform, make_user, monkeypatch, caplog):
+    make_user("logadm_present")
+    monkeypatch.setenv("MANGA_ADMIN_USERS", "logadm_missing,logadm_present")
+    caplog.set_level(logging.INFO)
+    with TestClient(platform.app):
+        pass
+    text = "\n".join(r.getMessage() for r in caplog.records)
+    assert "logadm_missing" in text and "アカウントなし" in text
+    assert "logadm_present" in text and "登録済み" in text and "logadm_present@example.com" in text
+    missing = [r for r in caplog.records if "logadm_missing" in r.getMessage()]
+    assert missing and missing[0].levelno == logging.WARNING
+
+
