+# ---------------------------------------------------------------------------
+# コマンドとして実行（別のフォルダから）
+# ---------------------------------------------------------------------------
+
+def _run_cli(site_copy, cwd, args, env_extra):
+    env = {**os.environ, **env_extra}
+    return subprocess.run(
+        [sys.executable, str(site_copy / "manage.py"), *args],
+        cwd=cwd, env=env, capture_output=True, text=True,
+        stdin=subprocess.DEVNULL, timeout=120)
+
+
+def test_cli_works_from_another_directory(platform, site_copy, tmp_path):
+    r = _run_cli(site_copy, tmp_path,
+                 ["create-admin", "cliadm", "--email", "cliadm@example.com", "--password-env", "CLI_PW"],
+                 {"MANGA_ADMIN_USERS": "cliadm", "CLI_PW": "password123"})
+    assert r.returncode == 0, r.stderr
+    assert "作成しました" in r.stdout
+    assert str(site_copy) in r.stdout                       # 対象DBはサイト側
+    assert list(tmp_path.iterdir()) == []                   # 実行したフォルダに DB や鍵を作らない
+    db = platform.SessionLocal()
+    assert db.query(platform.User).filter(platform.User.username == "cliadm").first() is not None
+    db.close()
+
+    r = _run_cli(site_copy, tmp_path, ["list-admins"], {"MANGA_ADMIN_USERS": "cliadm,cliadm2"})
+    assert r.returncode == 0
+    assert "cliadm: 登録済み" in r.stdout and "cliadm2: アカウントなし" in r.stdout
+
+
+def test_cli_reports_errors_with_exit_code_1(site_copy, tmp_path):
+    r = _run_cli(site_copy, tmp_path,
+                 ["create-admin", "cliadm3", "--email", "c3@example.com", "--password-env", "CLI_PW"],
+                 {"MANGA_ADMIN_USERS": "other", "CLI_PW": "password123"})
+    assert r.returncode == 1 and "MANGA_ADMIN_USERS" in r.stderr
+
+    r = _run_cli(site_copy, tmp_path,
+                 ["create-admin", "cliadm3", "--email", "c3@example.com"],
+                 {"MANGA_ADMIN_USERS": "cliadm3"})
+    assert r.returncode == 1 and "--password-env" in r.stderr
+
+    r = _run_cli(site_copy, tmp_path,
+                 ["create-admin", "cliadm3", "--email", "c3@example.com", "--password-env", "NOPE_PW"],
+                 {"MANGA_ADMIN_USERS": "cliadm3"})
+    assert r.returncode == 1 and "NOPE_PW" in r.stderr
+
