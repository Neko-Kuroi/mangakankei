+#!/usr/bin/env python3
+"""運用コマンド（管理者アカウントの作成・確認）。
+
+    python manage.py list-admins
+    python manage.py create-admin boss --email boss@example.com --password-env ADMIN_PW
+    python manage.py create-admin boss --email new@example.com --password-env ADMIN_PW --reset
+
+- どこから実行しても、このファイルのあるフォルダの DB（storage/manga_platform.db）を操作する。
+  実行時に「対象DB」として絶対パスを表示する。
+- 管理者名は環境変数 MANGA_ADMIN_USERS（カンマ区切り）で決まる。サーバーと同じ値を設定した
+  状態で実行すること（含まれない名前のアカウントは作らない）。
+- 管理者名は一般の登録では使えない（先取りで管理者になられないため）ので、
+  管理者アカウントの作成経路はこのコマンドだけ。
+- パスワードは引数に直接渡さない（シェル履歴・プロセス一覧に残るため）。
+  --password-env で環境変数名を渡すか、端末なら対話入力（getpass）にする。
+"""
+import argparse
+import getpass
+import os
+import sys
+from pathlib import Path
+from typing import List, Optional
+
+HERE = Path(__file__).resolve().parent
+
+
+class ManageError(Exception):
+    """利用者に伝えるべきエラー（終了コード 1）。"""
+
+
+def _validate_email(email: str) -> str:
+    from email_validator import EmailNotValidError, validate_email
+    try:
+        return validate_email(email, check_deliverability=False).normalized
+    except EmailNotValidError as e:
+        raise ManageError(f"メールアドレスが不正です: {e}")
+
+
+def create_admin(platform, username: str, email: Optional[str], password: str, *,
+                 reset: bool = False, account_type: Optional[str] = None) -> str:
+    """管理者アカウントを作る（reset=True なら既存アカウントのパスワードとメールを置き換える）。"""
+    if username not in platform.admin_names():
+        raise ManageError(
+            f"{username!r} は MANGA_ADMIN_USERS に含まれていません。"
+            "サーバーと同じ値を環境変数に設定してから実行してください。")
+    if account_type not in (None, "author", "reader"):
+        raise ManageError("--type は author か reader を指定してください")
+    pw_error = platform.password_rule_error(password)
+    if pw_error:
+        raise ManageError(pw_error)
+    email = _validate_email(email) if email else None
+
+    User = platform.User
+    db = platform.SessionLocal()
+    try:
+        user = db.query(User).filter(User.username == username).first()
+
+        if user is None:
+            if not email:
+                raise ManageError("新規作成には --email が必要です")
+            holder = db.query(User).filter(User.email == email).first()
+            if holder:
+                raise ManageError(f"メールアドレス {email} は {holder.username!r} が使用中です")
+            user = User(username=username, email=email,
+                        hashed_password=platform._hash_password(password),
+                        account_type=account_type or "author")
+            db.add(user)
+            db.commit()
+            return f"管理者アカウントを作成しました: {username}（email={email}, 種別={user.account_type}）"
+
+        if not reset:
+            raise ManageError(
+                f"{username!r} は既に登録されています（email={user.email}）。"
+                "自分のアカウントなら、そのまま管理者として使えます。"
+                "見覚えのないメールなら、--reset でパスワードとメールを置き換えてください。")
+
+        if email and email != user.email:
+            holder = (db.query(User)
+                      .filter(User.email == email, User.id != user.id).first())
+            if holder:
+                raise ManageError(f"メールアドレス {email} は {holder.username!r} が使用中です")
+            user.email = email
+        user.hashed_password = platform._hash_password(password)
+        user.is_active = True
+        if account_type:
+            user.account_type = account_type
+        db.commit()
+        return f"管理者アカウントを更新しました: {username}（email={user.email}, 種別={user.account_type}）"
+    finally:
+        db.close()
+
+
+def list_admins(platform) -> List[str]:
+    """MANGA_ADMIN_USERS の各名前について、アカウントの状況を1行ずつ返す。"""
+    names = sorted(platform.admin_names())
+    if not names:
+        return ["MANGA_ADMIN_USERS が設定されていません（管理者はいません）"]
+    db = platform.SessionLocal()
+    try:
+        lines = []
+        for name in names:
+            user = db.query(platform.User).filter(platform.User.username == name).first()
+            if user is None:
+                lines.append(f"{name}: アカウントなし")
+            else:
+                lines.append(f"{name}: 登録済み（id={user.id}, email={user.email}, "
+                             f"種別={user.account_type or 'author'}, 有効={bool(user.is_active)}）")
+        return lines
+    finally:
+        db.close()
+
+
+def read_password(password_env: Optional[str]) -> str:
+    if password_env:
+        value = os.environ.get(password_env, "")
+        if not value:
+            raise ManageError(f"環境変数 {password_env} が空か未設定です")
+        return value
+    if not sys.stdin.isatty():
+        raise ManageError(
+            "パスワードは --password-env で渡してください（対話入力は端末でのみ使えます）")
+    first = getpass.getpass("パスワード: ")
+    if first != getpass.getpass("もう一度: "):
+        raise ManageError("パスワードが一致しません")
+    return first
+
+
+def _load_platform():
+    # 本体は ./storage や ./instance を実行時のカレントディレクトリ相対で解決する。
+    # 別のフォルダから import すると、そこに空の DB と別の秘密鍵が作られてしまうので、
+    # 必ずこのファイルのあるフォルダへ移動してから import する。
+    os.chdir(HERE)
+    if str(HERE) not in sys.path:
+        sys.path.insert(0, str(HERE))
+    import main as platform
+    return platform
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="管理者アカウントの作成・確認")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    sub.add_parser("list-admins", help="MANGA_ADMIN_USERS の各名前のアカウント状況を表示")
+
+    create = sub.add_parser("create-admin", help="管理者アカウントを作成（--reset で置き換え）")
+    create.add_argument("username")
+    create.add_argument("--email", help="新規作成には必須。--reset ではメールを置き換える")
+    create.add_argument("--password-env", metavar="VAR",
+                        help="パスワードを入れた環境変数の名前（省略時は端末で対話入力）")
+    create.add_argument("--reset", action="store_true",
+                        help="既存アカウントのパスワード・メールを置き換え、有効に戻す")
+    create.add_argument("--type", dest="account_type", choices=["author", "reader"],
+                        help="アカウント種別（新規は author が既定。--reset では指定時のみ変更）")
+    return parser
+
+
+def run(argv: Optional[List[str]] = None) -> int:
+    args = _build_parser().parse_args(argv)
+    try:
+        password = read_password(args.password_env) if args.command == "create-admin" else None
+        platform = _load_platform()
+        db_path = (Path.cwd() / (platform.engine.url.database or "")).resolve()
+        print(f"対象DB: {db_path}")
+        if args.command == "list-admins":
+            print("\n".join(list_admins(platform)))
+        else:
+            print(create_admin(platform, args.username, args.email, password,
+                               reset=args.reset, account_type=args.account_type))
+        return 0
+    except ManageError as e:
+        print(f"エラー: {e}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(run())
