+    #  そちらは test_ratelimit_key2.py で検証する）
+    r = internal_client.post(
+        "/api/auth/token",
+        data={"username": "rk_login_other", "password": "password123"},
+        headers=_internal(KEY_B))
+    assert r.status_code == 200
+
+
