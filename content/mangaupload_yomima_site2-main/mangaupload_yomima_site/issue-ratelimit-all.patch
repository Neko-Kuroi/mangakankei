+
+def test_secret_file_generated_with_0600(viewer_secret, monkeypatch, tmp_path):
+    monkeypatch.delenv("MANGA_CLIENT_KEY_SECRET", raising=False)
+    target = tmp_path / "instance" / "client_key_secret"
