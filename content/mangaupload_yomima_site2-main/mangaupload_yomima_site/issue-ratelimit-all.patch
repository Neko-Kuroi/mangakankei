+    return Request(scope)
+
+
+def test_get_ip_for_limit_branches(platform):
+    assert platform.get_ip_for_limit(
+        _fake_request("127.0.0.1", _internal(KEY_A))) == "viewer:" + KEY_A
+    assert platform.get_ip_for_limit(
